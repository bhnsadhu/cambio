{
  "name": "cambio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:accounts": "node scripts/test-accounts.mjs",
    "results": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/results/ts-hooks.mjs scripts/results/run.ts",
    "seed:friends": "node --env-file=.env.local scripts/seed-friends.mjs",
    "brand:assets": "node scripts/brand-assets.mjs",
    "test:brand": "playwright test -c playwright.brand.config.ts",
    "ml:data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/results/ts-hooks.mjs scripts/ml/collect.ts",
    "ml:tune": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/results/ts-hooks.mjs scripts/ml/tune.ts",
    "ml:evaluate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/results/ts-hooks.mjs scripts/ml/evaluate.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/functions": "^3.9.8",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
